# Copy this file to .env and fill in your credentials
SECRET_KEY=cambia-esto-por-una-clave-segura

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Gmail OAuth2 — Google Cloud Console → APIs & Services → Credentials
# Tipo: Web application | URI de redirección: https://datos.papiatech.com/emails/oauth2callback
GMAIL_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REDIRECT_URI=https://datos.papiatech.com/emails/oauth2callback

# Stripe — Pagos
# Dashboard: https://dashboard.stripe.com/apikeys
# Webhook:   https://dashboard.stripe.com/webhooks → https://datos.papiatech.com/webhook/stripe
APP_BASE_URL=https://datos.papiatech.com
# Meta (Messenger + Instagram)
# META_VERIFY_TOKEN: cadena que tú inventas, la misma que pones en el dashboard de Meta
# META_APP_SECRET:   Configuración → Básica en el dashboard de Meta
META_VERIFY_TOKEN=papia_meta_verify_cambia_esto
META_APP_SECRET=TU_META_APP_SECRET_AQUI

STRIPE_SECRET_KEY=TU_STRIPE_SECRET_KEY_AQUI
STRIPE_WEBHOOK_SECRET=TU_STRIPE_WEBHOOK_SECRET_AQUI

# WhatsApp vía Zernio (Meta Cloud API) — proveedor principal
# ZERNIO_API_KEY:        zernio.com → API Keys (read-write)
# ZERNIO_WA_ACCOUNT_ID:  lo imprime `python zernio_setup.py accounts`
# ZERNIO_WEBHOOK_SECRET: cadena larga que inventas; la misma va en el webhook de Zernio
# Webhook a registrar en Zernio: https://datos.papiatech.com/webhook/zernio
WHATSAPP_PROVIDER=zernio
ZERNIO_API_KEY=sk_xxxxxxxxxxxxxxxx
ZERNIO_WA_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
ZERNIO_WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo

# Twilio — WhatsApp (legacy / respaldo)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Webhook público (para registrar en Twilio Sandbox)
# https://datos.papiatech.com/webhook/whatsapp

# ── Bóveda de contraseñas por cliente ──
# Clave Fernet para cifrar los accesos guardados. Genérala UNA vez y no la cambies
# (si se pierde, los accesos guardados no se pueden descifrar). Haz backup aparte.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# ── Papia Sign (Contratos) ──
# Sello digital PAdES del PDF final. Si lo dejas vacío, el CRM genera un certificado
# propio por organización en contract_files/_keys/ (integridad garantizada, pero Acrobat
# lo mostrará como "identidad desconocida"). Para la marca verde en Acrobat usa un
# certificado de la lista AATL de Adobe (formato PEM).
SIGN_CERT_FILE=
SIGN_KEY_FILE=
SIGN_KEY_PASSWORD=
# Sello de tiempo RFC 3161 opcional (requiere salida a internet), p. ej.:
# SIGN_TSA_URL=http://timestamp.digicert.com
SIGN_TSA_URL=
