# ═══════════════════════════════════════════════════════════════════════════
#  .env de la instancia — copia este archivo a .env (o usa ./setup.sh).
#  NUNCA lo subas a git. Marca, servicios y prompt del bot van en instance/.
# ═══════════════════════════════════════════════════════════════════════════

# ── Básico ─────────────────────────────────────────────────────────────────
# Clave de sesión: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# URL pública del CRM, sin "/" al final (webhooks, links de pago y de propuestas)
APP_BASE_URL=https://crm.tucliente.com
# Zona horaria (opcional; si no, la de instance/brand.json)
# APP_TIMEZONE=America/New_York
# Orígenes que pueden enviar leads a POST /api/new-lead (opcional; si no, brand.json → cors_origins)
# CORS_ORIGINS=https://tucliente.com,https://www.tucliente.com
# Base de datos (opcional; por defecto papia_crm.db junto a app.py)
# DATABASE_PATH=/home/usuario/crm-data/crm.db
# Carpeta de configuración de la instancia (opcional; por defecto ./instance)
# INSTANCE_DIR=/home/usuario/crm-config

# ── Superadmin inicial (se crea al primer arranque) ───────────────────────
ADMIN_USERNAME=admin
# Obligatoria y segura: si está vacía o es "admin", no se crea el usuario
ADMIN_PASSWORD=

# ── Gmail + Google Calendar (OAuth) ───────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Habilita Gmail API y Google Calendar API en el proyecto.
# URI de redirección autorizada: <APP_BASE_URL>/emails/oauth2callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://crm.tucliente.com/emails/oauth2callback

# ── WhatsApp ───────────────────────────────────────────────────────────────
# Proveedor: zernio (Meta Cloud API, recomendado) o twilio
WHATSAPP_PROVIDER=zernio

# Zernio: zernio.com → API Keys (read-write). El accountId lo imprime:
#   python zernio_setup.py accounts
# Webhook: python zernio_setup.py webhook  (registra <APP_BASE_URL>/webhook/zernio)
ZERNIO_API_KEY=
ZERNIO_WA_ACCOUNT_ID=
# Cadena larga que inventas; la misma queda registrada en el webhook de Zernio
ZERNIO_WEBHOOK_SECRET=

# Twilio (respaldo): webhook entrante <APP_BASE_URL>/webhook/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# ── Asistente de WhatsApp con Claude ──────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# AI_BOT_MODEL=claude-haiku-4-5
# AI_LEARN_MODEL=claude-sonnet-4-5

# ── Meta (Messenger + Instagram) ──────────────────────────────────────────
# Webhook: <APP_BASE_URL>/webhook/meta — META_VERIFY_TOKEN es una cadena que tú inventas
META_VERIFY_TOKEN=
META_APP_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────────────
# dashboard.stripe.com/apikeys — Webhook: <APP_BASE_URL>/webhook/stripe
# (también se pueden guardar por organización desde Configuración → Pagos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Bóveda de contraseñas por cliente ─────────────────────────────────────
# Clave Fernet. Genérala UNA vez y no la cambies (si se pierde, los accesos guardados
# no se pueden descifrar). Haz backup aparte:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# ── n8n (opcional) ─────────────────────────────────────────────────────────
# N8N_WEBHOOK_URL=
# N8N_BOT_SECRET=
# Token para GET /api/payment-reminders/due (header X-API-Key)
# N8N_PAYMENTS_TOKEN=
